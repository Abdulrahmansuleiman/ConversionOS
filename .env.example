# LaunchOps Onboarding Agent System — environment keys
# Copy to .env and fill real values. Never commit .env.

# --- Gmail API (Email Agent sends via Gmail OAuth) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=

# --- Supabase ([DATA_STORE] — webhook events, dashboard data) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel (dashboard deployment) ---
VERCEL_TOKEN=

# --- GoHighLevel (form/intake webhook verification) ---
GHL_WEBHOOK_SECRET=

# --- Notion (project store — LaunchOps HQ databases, portal backend) ---
NOTION_TOKEN=

# --- LaunchOps Client Portal (password gate) ---
PORTAL_PASSWORD=

# --- n8n (ConversionOS workflow) ---
N8N_ACCESS_TOKEN=
N8N_SERVER_URL=

NOTION_TOKEN=